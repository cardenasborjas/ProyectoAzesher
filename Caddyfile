sistema.azesher.com {
    encode zstd gzip

    @backend path /api/* /hubs/*
    reverse_proxy @backend api:8080
    reverse_proxy frontend:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' wss:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }
}
